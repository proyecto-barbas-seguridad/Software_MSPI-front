{
  "name": "mspi-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "contracts:generate": "node tools/contracts/generate.mjs",
    "contracts:check": "node tools/contracts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:ui": "vitest run",
    "test:gateway": "node --test test/*.test.mjs",
    "test": "npm run test:ui && npm run test:gateway"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
